# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v3.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 默认关闭通知，本地运行不需要任何密钥
NOTIFICATIONS_ENABLED=false

# 仅在 NOTIFICATIONS_ENABLED=true 时需要配置
FEISHU_WEBHOOK_URL=

# 默认只启用经初步筛选的技术策略，逗号分隔
ENABLED_STRATEGIES=ma_volume,turtle,flag,rps

# 数据质量闸门：最新交易日覆盖的本地股票比例不得低于 95%
MINIMUM_LATEST_COVERAGE=0.95

# 允许的最大自然日数据年龄，覆盖周末和长假期
MAX_DATA_AGE_DAYS=10

# 策略专属 Webhook（可选）
# STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
